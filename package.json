{
  "name": "@egen-civitas/esm-framework-core",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "packages/framework/*",
    "packages/tooling/*",
    "packages/shell/*"
  ],
  "resolutions": {
    "@types/react": "18.3.25",
    "csstype": "3.2.3"
  },
  "scripts": {
    "build": "turbo run build",
    "document": "turbo run document",
    "setup": "yarn install && turbo run build",
    "start": "egen develop",
    "verify": "turbo run lint test typescript",
    "test": "turbo run test",
    "coverage": "turbo run test --coverage",
    "storybook": "yarn workspace @egen-civitas/storybook storybook",
    "ci:publish-next": "yarn workspaces foreach --all --topological --exclude @egen-civitas/esm-framework-core --exclude @egen-civitas/storybook exec npm publish --access public --tag next",
    "ci:publish": "yarn workspaces foreach --all --topological --exclude @egen-civitas/esm-framework-core --exclude @egen-civitas/storybook exec npm publish --access public --tag latest",
    "release": "yarn workspaces foreach --all --topological version",
    "verify:publint": "node scripts/verify-publint.mjs",
    "verify:attw": "node scripts/verify-attw.mjs",
    "verify:pack": "node scripts/verify-pack-install.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@egen-civitas/egen": "workspace:*",
    "@playwright/test": "^1.55.1",
    "@swc/core": "1.15.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.16.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "classnames": "^2.3.2",
    "cross-env": "^10.1.0",
    "dotenv": "^16.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^7.1.1",
    "fake-indexeddb": "^4.0.2",
    "fork-ts-checker-webpack-plugin": "^7.2.13",
    "husky": "^8.0.3",
    "i18next-parser": "^9.3.0",
    "identity-obj-proxy": "^3.0.0",
    "lint-staged": "^15.2.9",
    "prettier": "^3.1.0",
    "publint": "^0.3.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swc-loader": "0.2.7",
    "timezone-mock": "^1.2.2",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.105.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix --max-warnings 0",
    "*.{css,scss,ts,tsx}": "prettier --write --list-different"
  }
}
