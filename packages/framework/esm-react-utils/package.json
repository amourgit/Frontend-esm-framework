{
  "name": "@egen-civitas/esm-react-utils",
  "version": "1.0.2",
  "license": "MPL-2.0",
  "description": "React utilities for Egen.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "mock.tsx",
    "mock-jest.tsx"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./src/public": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    },
    "./mock": {
      "import": "./mock.tsx",
      "require": "./mock-jest.tsx"
    }
  },
  "source": true,
  "scripts": {
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src"
  },
  "keywords": [
    "egen",
    "microfrontends",
    "react",
    "support",
    "utilities"
  ],
  "directories": {
    "lib": "dist",
    "src": "src"
  },
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-framework.git",
    "directory": "packages/framework/esm-react-utils"
  },
  "bugs": {
    "url": "https://github.com/amourgit/Frontend-esm-framework/issues"
  },
  "homepage": "https://github.com/amourgit/Frontend-esm-framework/tree/main/packages/framework/esm-react-utils#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "single-spa-react": "^6.0.2"
  },
  "peerDependencies": {
    "@egen-civitas/esm-api": "^1.1.0",
    "@egen-civitas/esm-config": "^1.0.0",
    "@egen-civitas/esm-context": "^1.0.0",
    "@egen-civitas/esm-data-api": "^1.0.0",
    "@egen-civitas/esm-error-handling": "^1.0.0",
    "@egen-civitas/esm-extensions": "^1.0.0",
    "@egen-civitas/esm-feature-flags": "^1.0.0",
    "@egen-civitas/esm-globals": "^1.0.0",
    "@egen-civitas/esm-navigation": "^1.0.0",
    "@egen-civitas/esm-state": "^1.0.0",
    "@egen-civitas/esm-tenant": "^1.0.0",
    "@egen-civitas/esm-utils": "^1.0.0",
    "dayjs": "1.x",
    "i18next": "25.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "rxjs": "7.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@egen-civitas/esm-api": "^1.1.0",
    "@egen-civitas/esm-config": "^1.0.0",
    "@egen-civitas/esm-context": "^1.0.0",
    "@egen-civitas/esm-data-api": "^1.0.0",
    "@egen-civitas/esm-error-handling": "^1.0.0",
    "@egen-civitas/esm-expression-evaluator": "^1.0.0",
    "@egen-civitas/esm-extensions": "^1.0.0",
    "@egen-civitas/esm-feature-flags": "^1.0.0",
    "@egen-civitas/esm-globals": "^1.0.0",
    "@egen-civitas/esm-navigation": "^1.0.0",
    "@egen-civitas/esm-state": "^1.0.0",
    "@egen-civitas/esm-utils": "^1.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@types/fhir": "0.0.31",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "happy-dom": "^20.6.0",
    "i18next": "^25.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.0",
    "single-spa": "^6.0.3",
    "swr": "2.2.5",
    "vitest": "^4.1.2"
  }
}
