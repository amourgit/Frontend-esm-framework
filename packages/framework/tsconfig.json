{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "ESNext",
    "target": "es2020",
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "strictNullChecks": true,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "es2022"
    ],
    "skipLibCheck": true
  }
}
