{
  "name": "@egen-civitas/esm-app-shell",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "yarn run watch",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "watch": "cross-env EGEN_CLEAN_BEFORE_BUILD=\"true\" NODE_ENV=\"development\" EGEN_OFFLINE=\"disable\" EGEN_ESM_IMPORTMAP='{\"imports\":{}}' EGEN_ROUTES='{}' rspack serve --mode development",
    "build:production": "cross-env EGEN_OFFLINE=\"enable\" EGEN_CLEAN_BEFORE_BUILD=\"true\" NODE_ENV=\"production\" EGEN_ESM_IMPORTMAP='{\"imports\":{}}' EGEN_ROUTES='{}' rspack --mode production",
    "build:development": "cross-env EGEN_OFFLINE=\"enable\" EGEN_CLEAN_BEFORE_BUILD=\"true\" NODE_ENV=\"development\" rspack --mode development",
    "build": "yarn run build:production && yarn run build:development",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "eslint src --ext ts,tsx"
  },
  "keywords": [
    "egen",
    "microfrontends"
  ],
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-framework.git",
    "directory": "packages/shell/esm-app-shell"
  },
  "bugs": {
    "url": "https://github.com/amourgit/Frontend-esm-framework/issues"
  },
  "homepage": "https://github.com/amourgit/Frontend-esm-framework/tree/main/packages/shell/esm-app-shell#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@carbon/react": "^1.92.1",
    "@egen-civitas/esm-api": "^1.0.0",
    "@egen-civitas/esm-config": "^1.0.0",
    "@egen-civitas/esm-framework": "^1.0.0",
    "@egen-civitas/esm-globals": "^1.0.0",
    "@egen-civitas/esm-offline": "^1.0.0",
    "@egen-civitas/esm-react-utils": "^1.0.0",
    "@egen-civitas/esm-state": "^1.0.0",
    "@egen-civitas/esm-styleguide": "^1.0.0",
    "@egen-civitas/esm-tenant": "^1.0.0",
    "@egen-civitas/esm-theme": "^1.0.0",
    "@egen-civitas/esm-utils": "^1.0.0",
    "@internationalized/date": "^3.8.0",
    "@rspack/cli": "1.7.9",
    "@rspack/core": "1.7.9",
    "dayjs": "^1.11.13",
    "dexie": "^3.0.3",
    "html-webpack-plugin": "5.6.6",
    "i18next": "^25.5.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "lodash-es": "^4.17.21",
    "mini-css-extract-plugin": "2.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.3.0",
    "rxjs": "^6.5.3",
    "semver": "^7.7.3",
    "single-spa": "^6.0.3",
    "swc-loader": "0.2.7",
    "swr": "2.2.5",
    "webpack-pwa-manifest": "4.3.0"
  },
  "devDependencies": {
    "@swc/core": "1.15.21",
    "cross-env": "^10.1.0",
    "dotenv": "^16.0.3",
    "react-is": "^17.0.2",
    "sass": "^1.98.0",
    "vitest": "^4.1.2",
    "webpack": "^5.105.3"
  }
}
