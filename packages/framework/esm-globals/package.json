{
  "name": "@egen/esm-globals",
  "version": "9.0.2",
  "license": "MPL-2.0",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/public": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    }
  },
  "source": true,
  "scripts": {
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch --passWithNoTests",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx"
  },
  "keywords": [
    "egen",
    "framework",
    "frontend",
    "ui",
    "microfrontends"
  ],
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egen/egen-esm-core.git"
  },
  "bugs": {
    "url": "https://github.com/egen/egen-esm-core/issues"
  },
  "homepage": "https://github.com/egen/egen-esm-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/fhir": "0.0.31"
  },
  "peerDependencies": {
    "single-spa": "6.x"
  },
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "concurrently": "^9.2.1",
    "rimraf": "^6.1.3",
    "single-spa": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
