{
  "name": "@egen-civitas/esm-navigation",
  "version": "1.0.1",
  "license": "MPL-2.0",
  "description": "Egen library providing tools for breadcrumbs, navigation, and history.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/public": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    }
  },
  "source": true,
  "scripts": {
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch --passWithNoTests",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx"
  },
  "keywords": [
    "egen",
    "microfrontends"
  ],
  "directories": {
    "lib": "dist",
    "src": "src"
  },
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-framework.git",
    "directory": "packages/framework/esm-navigation"
  },
  "bugs": {
    "url": "https://github.com/amourgit/Frontend-esm-framework/issues"
  },
  "homepage": "https://github.com/amourgit/Frontend-esm-framework/tree/main/packages/framework/esm-navigation#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "path-to-regexp": "^8.3.0"
  },
  "peerDependencies": {
    "@egen-civitas/esm-state": "^1.0.0",
    "single-spa": "6.x"
  },
  "devDependencies": {
    "@egen-civitas/esm-globals": "^1.0.0",
    "@egen-civitas/esm-state": "^1.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.6.0",
    "i18next": "^25.5.3",
    "jsdom": "^29.0.2",
    "lodash": "4.17.21",
    "react": "^18.3.1",
    "rimraf": "^6.1.3",
    "single-spa": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
