{
  "name": "@egen/esm-ai-config",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Configuration typée, validée et observable pour la couche IA EGEN. Zéro valeur codée en dur.",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "import": "./mock.ts",
      "require": "./mock.ts"
    }
  },
  "scripts": {
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests"
  },
  "keywords": [
    "egen",
    "microfrontends",
    "ai",
    "config"
  ],
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-core.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@egen/esm-state": "workspace:*"
  },
  "peerDependencies": {
    "@egen/esm-state": "9.x",
    "rxjs": "^6.5.3"
  },
  "devDependencies": {
    "@egen/esm-state": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "rxjs": "^6.5.3",
    "vitest": "^4.1.2"
  }
}
