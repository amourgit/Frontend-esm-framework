{
  "name": "@egen-civitas/esm-vue-utils",
  "version": "0.2.0",
  "license": "MPL-2.0",
  "description": "Intégration des applications Vue 3 à EGEN : lifecycles, composables et composants d'extensions (pendant de esm-react-utils)",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "source": true,
  "scripts": {
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch --passWithNoTests",
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx"
  },
  "keywords": [
    "egen",
    "microfrontends",
    "vue"
  ],
  "directories": {
    "lib": "dist",
    "src": "src"
  },
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-framework.git",
    "directory": "packages/framework/esm-vue-utils"
  },
  "bugs": {
    "url": "https://github.com/amourgit/Frontend-esm-framework/issues"
  },
  "homepage": "https://github.com/amourgit/Frontend-esm-framework#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@egen-civitas/esm-integration-utils": "^0.2.0",
    "single-spa-vue": "^3.0.1"
  },
  "peerDependencies": {
    "@egen-civitas/esm-api": ">=3.0.0",
    "@egen-civitas/esm-config": ">=2.0.0",
    "@egen-civitas/esm-extensions": ">=2.0.0",
    "@egen-civitas/esm-feature-flags": ">=1.0.0",
    "@egen-civitas/esm-globals": ">=2.5.0",
    "@egen-civitas/esm-integration-utils": ">=0.2.0",
    "single-spa": "6.x",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@types/node": "^20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.6.0",
    "rimraf": "^6.1.3",
    "single-spa": "^6.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2",
    "vue": "^3.5.0",
    "zustand": "^4.5.5"
  }
}
