{
  "name": "@egen/esm-config",
  "version": "9.0.2",
  "license": "MPL-2.0",
  "description": "A configuration library for the Egen Single-Spa framework.",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./src/public": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    },
    "./mock": {
      "import": "./mock.ts",
      "require": "./mock-jest.ts"
    }
  },
  "source": true,
  "scripts": {
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch --passWithNoTests",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx"
  },
  "keywords": [
    "egen",
    "microfrontends"
  ],
  "directories": {
    "lib": "dist",
    "src": "src"
  },
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egen/egen-esm-core.git"
  },
  "bugs": {
    "url": "https://github.com/egen/egen-esm-core/issues"
  },
  "homepage": "https://github.com/egen/egen-esm-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  },
  "peerDependencies": {
    "@egen/esm-globals": "9.x",
    "@egen/esm-state": "9.x",
    "@egen/esm-utils": "9.x",
    "single-spa": "6.x"
  },
  "devDependencies": {
    "@egen/esm-globals": "workspace:*",
    "@egen/esm-state": "workspace:*",
    "@egen/esm-utils": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "happy-dom": "^20.6.0",
    "i18next": "^25.5.3",
    "react": "^18.3.1",
    "rimraf": "^6.1.3",
    "rxjs": "^6.6.7",
    "single-spa": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
