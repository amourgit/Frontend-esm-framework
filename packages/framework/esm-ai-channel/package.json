{
  "name": "@egen-civitas/esm-ai-channel",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Canal temps réel EGEN frontend ↔ backend IA — protocole, transport WebSocket, provisionnement des tools frontend, appels de tools, contexte et conversation.",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests"
  },
  "keywords": [
    "egen",
    "microfrontends",
    "ai",
    "websocket",
    "realtime"
  ],
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-framework.git",
    "directory": "packages/framework/esm-ai-channel"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@egen-civitas/esm-ai-config": "^1.1.0",
    "@egen-civitas/esm-ai-context": "^1.0.0",
    "@egen-civitas/esm-ai-events": "^1.1.0",
    "@egen-civitas/esm-ai-tools": "^1.0.2",
    "@egen-civitas/esm-api": "^1.1.1"
  },
  "peerDependencies": {
    "@egen-civitas/esm-ai-config": "^1.1.0",
    "@egen-civitas/esm-ai-context": "^1.0.0",
    "@egen-civitas/esm-ai-events": "^1.1.0",
    "@egen-civitas/esm-ai-tools": "^1.0.2",
    "@egen-civitas/esm-api": "^1.1.1",
    "react": "18.x"
  },
  "devDependencies": {
    "@egen-civitas/esm-ai-config": "^1.1.0",
    "@egen-civitas/esm-ai-context": "^1.0.0",
    "@egen-civitas/esm-ai-events": "^1.1.0",
    "@egen-civitas/esm-ai-tools": "^1.0.2",
    "@egen-civitas/esm-api": "^1.1.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@types/react": "^18.3.21",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "react": "^18.0.0",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.2"
  },
  "bugs": {
    "url": "https://github.com/amourgit/Frontend-esm-framework/issues"
  },
  "homepage": "https://github.com/amourgit/Frontend-esm-framework/tree/main/packages/framework/esm-ai-channel#readme"
}
