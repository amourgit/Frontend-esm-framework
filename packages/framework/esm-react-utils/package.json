{
  "name": "@egen/esm-react-utils",
  "version": "9.0.2",
  "license": "MPL-2.0",
  "description": "React utilities for Egen.",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./src/public": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    },
    "./mock": {
      "import": "./mock.tsx",
      "require": "./mock-jest.tsx"
    }
  },
  "source": true,
  "scripts": {
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src"
  },
  "keywords": [
    "egen",
    "microfrontends",
    "react",
    "support",
    "utilities"
  ],
  "directories": {
    "lib": "dist",
    "src": "src"
  },
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egen/egen-esm-core.git"
  },
  "bugs": {
    "url": "https://github.com/egen/egen-esm-core/issues"
  },
  "homepage": "https://github.com/egen/egen-esm-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "single-spa-react": "^6.0.2"
  },
  "peerDependencies": {
    "@egen/esm-api": "9.x",
    "@egen/esm-config": "9.x",
    "@egen/esm-context": "9.x",
    "@egen/esm-data-api": "9.x",
    "@egen/esm-error-handling": "9.x",
    "@egen/esm-extensions": "9.x",
    "@egen/esm-feature-flags": "9.x",
    "@egen/esm-globals": "9.x",
    "@egen/esm-navigation": "9.x",
    "@egen/esm-state": "9.x",
    "@egen/esm-tenant": "1.x",
    "@egen/esm-utils": "9.x",
    "dayjs": "1.x",
    "i18next": "25.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "rxjs": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@egen/esm-api": "workspace:*",
    "@egen/esm-config": "workspace:*",
    "@egen/esm-context": "workspace:*",
    "@egen/esm-data-api": "workspace:*",
    "@egen/esm-error-handling": "workspace:*",
    "@egen/esm-expression-evaluator": "workspace:*",
    "@egen/esm-extensions": "workspace:*",
    "@egen/esm-feature-flags": "workspace:*",
    "@egen/esm-globals": "workspace:*",
    "@egen/esm-navigation": "workspace:*",
    "@egen/esm-state": "workspace:*",
    "@egen/esm-utils": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@types/fhir": "0.0.31",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "happy-dom": "^20.6.0",
    "i18next": "^25.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "rimraf": "^6.1.3",
    "rxjs": "^6.5.3",
    "single-spa": "^6.0.3",
    "swr": "2.2.5",
    "vitest": "^4.1.2"
  }
}
