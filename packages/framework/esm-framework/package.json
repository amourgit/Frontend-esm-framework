{
  "name": "@egen-civitas/esm-framework",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./mock": {
      "import": "./mock.tsx",
      "require": "./mock-jest.tsx"
    },
    "./mock.tsx": {
      "import": "./mock.tsx",
      "require": "./mock-jest.tsx"
    }
  },
  "source": true,
  "scripts": {
    "document": "../../../tools/document.sh",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx"
  },
  "keywords": [
    "egen",
    "framework",
    "frontend",
    "ui",
    "microfrontends"
  ],
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egen/egen-esm-core.git"
  },
  "bugs": {
    "url": "https://github.com/egen/egen-esm-core/issues"
  },
  "homepage": "https://github.com/egen/egen-esm-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@egen-civitas/esm-api": "workspace:*",
    "@egen-civitas/esm-config": "workspace:*",
    "@egen-civitas/esm-context": "workspace:*",
    "@egen-civitas/esm-data-api": "workspace:*",
    "@egen-civitas/esm-dynamic-loading": "workspace:*",
    "@egen-civitas/esm-error-handling": "workspace:*",
    "@egen-civitas/esm-expression-evaluator": "workspace:*",
    "@egen-civitas/esm-extensions": "workspace:*",
    "@egen-civitas/esm-feature-flags": "workspace:*",
    "@egen-civitas/esm-globals": "workspace:*",
    "@egen-civitas/esm-navigation": "workspace:*",
    "@egen-civitas/esm-offline": "workspace:*",
    "@egen-civitas/esm-react-utils": "workspace:*",
    "@egen-civitas/esm-routes": "workspace:*",
    "@egen-civitas/esm-state": "workspace:*",
    "@egen-civitas/esm-styleguide": "workspace:*",
    "@egen-civitas/esm-tenant": "workspace:*",
    "@egen-civitas/esm-translations": "workspace:*",
    "@egen-civitas/esm-utils": "workspace:*"
  },
  "peerDependencies": {
    "dayjs": "1.x",
    "i18next": "25.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "rxjs": "6.x",
    "single-spa": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@egen-civitas/typedoc-plugin-file-categories": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "happy-dom": "^20.6.0",
    "i18next": "^25.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-is": "^17.0.2",
    "rimraf": "^6.1.3",
    "sass": "^1.98.0",
    "single-spa": "^6.0.3",
    "typedoc": "^0.28.5",
    "typedoc-plugin-markdown": "^4.6.3",
    "typedoc-plugin-no-inherit": "^1.6.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  }
}
