{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true
  },
  "extends": "./tsconfig.json",
  "exclude": [
    "**/*.test.*",
    "**/setup-tests.ts",
    "**/__mocks__/*",
    "**/mock.tsx"
  ]
}
