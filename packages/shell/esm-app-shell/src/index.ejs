<!DOCTYPE html>
<html lang="<%= egenDefaultLocale %>" data-default-lang="<%= egenDefaultLocale %>">
  <head>
    <meta charset="utf-8">
    <% if (egenCsp) { %><meta http-equiv="Content-Security-Policy" content="<%= egenCsp %>">
    <% } %><meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title><%= egenPageTitle %></title>
    <link
      rel="shortcut icon"
      type="image/x-icon"
      href="<%= egenFavicon %>"
    >
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!--
      Anti-FOUC : pose la classe « dark » AVANT le chargement de la CSS, pour que le mode sombre s'applique dès la
      première peinture. Les variables de thème, elles, sont écrites par @egen-civitas/esm-theme (runtime) ; ce bloc
      ne fait que reprendre le choix de mode mémorisé (« egen-theme-mode », sombre par défaut).
    -->
    <% if (!egenBootstrap) { %><script>
      (function () {
        try {
          var stored = window.localStorage.getItem('egen-theme-mode');
          var mode = (stored === 'light' || stored === 'dark') ? stored : 'dark';
          document.documentElement.classList.toggle('dark', mode === 'dark');
        } catch (e) {
          document.documentElement.classList.toggle('dark', true);
        }
      })();
    </script><% } else { %><script src="<%= egenPublicPath %>/<%= egenBootstrap.head %>"></script><% } %>
    <meta name="importmap-type" content="systemjs-importmap">
    <link rel="stylesheet" href="<%= egenPublicPath %>/<%= egenCssFilename %>">
    <%= htmlWebpackPlugin.tags.headTags %>
<% if (egenExtraAssets && egenExtraAssets.length) { %>
<% egenExtraAssets.forEach(function(asset) { %>
<% if (asset.endsWith('.css')) { %>
    <link rel="stylesheet" href="<%= egenPublicPath %>/<%= asset %>">
<% } %>
<% }); %>
<% } %>
<% if (egenImportmapDef) { %>
    <script type="systemjs-importmap"><%= egenImportmapDef %></script>
<% } else if (egenImportmapUrl) { %>
    <link
      rel="preload"
      href="<%= egenImportmapUrl %>"
      as="fetch"
      crossorigin="anonymous"
    >
    <script type="systemjs-importmap" src="<%= egenImportmapUrl %>"></script>
<% } %>
<% if (egenCoreImportmap) { %>
  <script type="systemjs-importmap"><%= egenCoreImportmap %></script>
<% } %>
<% if (egenRoutesDef) { %>
  <script type="egen-routes"><%= egenRoutesDef %></script>
<% } else if (egenRoutesUrl) { %>
  <link
    rel="preload"
    href="<%= egenRoutesUrl %>"
    as="fetch"
    crossorigin="anonymous"
  >
  <script type="egen-routes" src="<%= egenRoutesUrl %>"></script>
<% } %>
<% if (egenTargetConfigDef && !egenBootstrap) { %>
    <script>
      // Pont EGEN_TARGET (.env, build) → window.egenTarget (lu par @egen-civitas/esm-globals : getEgenTarget())
      Object.assign(window, <%= egenTargetConfigDef %>);
    </script>
<% } %>
<% if (egenTenantConfigDef && !egenBootstrap) { %>
    <script>
      // Pont EGEN_TENANT_* (.env, build) → window.egenTenant* (lu par @egen-civitas/esm-tenant au runtime)
      Object.assign(window, <%= egenTenantConfigDef %>);
    </script>
<% } %>
<% if (egenCoreRoutes) { %>
  <script type="egen-routes"><%= egenCoreRoutes %></script>
<% } %>
    <!-- Fond et centrage des modales (showModal). CSS simple : la fenêtre elle-même est stylée en ligne par esm-styleguide. -->
    <style>
      .egen-modals-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9001;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, 0.5);
        visibility: hidden;
      }
      /* Page d'erreur de l'application (modèle #app-error) : CSS simple, sans dépendance à une bibliothèque de composants. */
      .egen-btn {
        display: inline-flex;
        align-items: center;
        min-height: 2.5rem;
        padding: 0 1rem;
        border: 1px solid transparent;
        border-radius: 0.375rem;
        background: #e5e7eb;
        color: #111827;
        font: inherit;
        cursor: pointer;
      }
      .egen-btn:hover { filter: brightness(0.95); }
      .egen-btn--primary { background: #0f62fe; color: #fff; }
      .egen-snippet {
        position: relative;
        max-width: 48rem;
        margin-top: 1rem;
        background: #f4f4f4;
        border-radius: 0.375rem;
      }
      .egen-snippet-container { overflow: auto; padding: 0.75rem 3rem 0.75rem 1rem; font-family: ui-monospace, monospace; font-size: 0.8125rem; }
      .egen-snippet-container pre { margin: 0; white-space: pre-wrap; }
      .egen-copy-btn { position: absolute; top: 0; right: 0; width: 2.5rem; height: 2.5rem; border: 0; background: transparent; cursor: pointer; }
      .egen-copy-btn:hover { background: rgba(0, 0, 0, 0.08); }
      .egen-copy-btn__feedback, .egen-assistive-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
      .egen-snippet__icon { fill: currentColor; }
    </style>
  </head>
  <body>
    <%= htmlWebpackPlugin.tags.bodyTags %>
<% if (egenExtraAssets && egenExtraAssets.length) { %>
<% egenExtraAssets.forEach(function(asset) { %>
<% if (asset.endsWith('.js')) { %>
    <script src="<%= egenPublicPath %>/<%= asset %>"></script>
<% } %>
<% }); %>
<% } %>
    <div class="egen-toasts-container"></div>
    <div class="egen-inline-notifications-container"></div>
    <div class="egen-actionable-notifications-container"></div>
    <div class="egen-snackbars-container"></div>
    <div class="egen-modals-container"></div>
    <!-- Arrière-plan global de page : rendu une seule fois ici, derrière le contenu des apps
         (voir renderPageBackground). Les apps le renseignent avec <PageBackground>. -->
    <div id="egen-page-background-container"></div>
    <div id="egen-workspaces-container"></div>
    <div id="egen-top-nav-app-container"></div>
    <div id="egen-ai-assistant-app-container"></div>
    <!-- Plan de travail (façon IntelliJ), rendu par le shell (voir renderWorkbench) :
         rails fixes gauche/droit, puis zones gauche, droite et bas redimensionnables.
         Les apps y déclarent leurs fenêtres d'outils par extensions (slots shell-rail-*). -->
    <div id="egen-rail-left-container"></div>
    <div id="egen-zone-left-container"></div>
    <!-- Zone centrale (scroll) : le contenu des apps défile ici, sous la TopBar,
         et est coupé net à sa frontière (voir _general.scss). -->
    <div id="egen-scroll-region">
      <div id="egen-apps-container"></div>
    </div>
    <div id="egen-zone-right-container"></div>
    <div id="egen-rail-right-container"></div>
    <div id="egen-zone-bottom-container"></div>
    <!-- Footer fixe en bas de page, au-dessus du contenu -->
    <div id="egen-footer-app-container"></div>
    <template id="app-error">
      <div class="egen-app-error">
        <h1>Application Error</h1>
        <p>Something went wrong. Please try reloading.</p>
        <p>Contact your system administrator if the problem persists.</p>
        <div id="buttons">
          <button class="egen-btn egen-btn--primary" <% if (!egenBootstrap) { %>onclick="location.reload()"<% } else { %>data-egen-action="reload"<% } %>>Reload</button>
        </div>
        <div class="egen-snippet" >
          <div tabindex="0"  class="egen-snippet-container"
            aria-label="Code Snippet Text">
            <pre>
              <code data-var="message"></code>
            </pre>
          </div>
          <button data-copy-btn class="egen-copy-btn" type="button" tabindex="0" <% if (!egenBootstrap) { %>onclick="copyText(this.parentElement)"<% } else { %>data-egen-action="copy"<% } %>>
            <span class="egen-assistive-text egen-copy-btn__feedback">Copied!</span>
            <svg focusable="false" preserveAspectRatio="xMidYMid meet" style="will-change: transform;" xmlns="http://www.w3.org/2000/svg" class="egen-snippet__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M14,5v9H5V5h9m0-1H5A1,1,0,0,0,4,5v9a1,1,0,0,0,1,1h9a1,1,0,0,0,1-1V5a1,1,0,0,0-1-1Z"></path><path d="M2,9H1V2A1,1,0,0,1,2,1H9V2H2Z"></path></svg>
          </button>
        </div>
      </div>
    </template>
    <% if (!egenBootstrap) { %><script>
      initializeSpa({
        apiUrl: "<%= egenApiUrl %>",
        spaPath: "<%= egenPublicPath %>",
        env: "<%= egenEnvironment %>",
        offline: <%= egenOffline %>,
        configUrls: [<%= egenConfigUrls %>],
      });
    </script><% } else { %><script src="<%= egenPublicPath %>/<%= egenBootstrap.body %>"></script><% } %>
  </body>
</html>
