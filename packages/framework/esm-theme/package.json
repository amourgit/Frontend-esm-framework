{
  "name": "@egen-civitas/esm-theme",
  "version": "1.1.0",
  "license": "MPL-2.0",
  "description": "Runtime de thème EGEN : contrat de thème au format Tweakcn, validation, variables CSS et mode clair/sombre, projection DTCG, client du backend du Core.",
  "main": "dist/index.js",
  "files": [
    "dist",
    "NOTICE",
    "LICENSE-MIT-TOKIFORGE",
    "LICENSE-APACHE-2.0"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "scripts": {
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist --ignore \\\"**/*.test.*\\\" --ignore \\\"**/__tests__/**\\\"\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist --ignore \\\"**/*.test.*\\\" --ignore \\\"**/__tests__/**\\\"\" \"tsc --project tsconfig.build.json\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch --passWithNoTests",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "culori": "4.0.1"
  },
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@types/culori": "^4.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-framework.git",
    "directory": "packages/framework/esm-theme"
  },
  "bugs": {
    "url": "https://github.com/amourgit/Frontend-esm-framework/issues"
  },
  "homepage": "https://github.com/amourgit/Frontend-esm-framework/tree/main/packages/framework/esm-theme#readme"
}
