{
  "name": "@egen/esm-error-handling",
  "version": "9.0.2",
  "license": "MPL-2.0",
  "description": "An ES module to help with error handling",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "source": true,
  "scripts": {
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch --passWithNoTests",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "build": "rimraf dist && swc --strip-leading-paths src -d dist && tsc --project tsconfig.build.json",
    "build:development": "rimraf dist && swc --strip-leading-paths src -d dist && tsc --project tsconfig.build.json",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx"
  },
  "keywords": [
    "egen",
    "microfrontends"
  ],
  "directories": {
    "lib": "dist",
    "src": "src"
  },
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egen/egen-esm-core.git"
  },
  "bugs": {
    "url": "https://github.com/egen/egen-esm-core/issues"
  },
  "homepage": "https://github.com/egen/egen-esm-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@egen/esm-globals": "9.x"
  },
  "devDependencies": {
    "@egen/esm-globals": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.6.0",
    "rimraf": "^6.1.3",
    "single-spa": "^6.0.3",
    "vitest": "^4.1.2"
  }
}
