{
  "name": "@egen-civitas/esm-framework",
  "version": "1.1.2",
  "license": "MPL-2.0",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "mock.tsx",
    "mock-jest.tsx"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./mock": {
      "import": "./mock.tsx",
      "require": "./mock-jest.tsx"
    },
    "./mock.tsx": {
      "import": "./mock.tsx",
      "require": "./mock-jest.tsx"
    }
  },
  "source": true,
  "scripts": {
    "document": "../../../tools/document.sh",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx"
  },
  "keywords": [
    "egen",
    "framework",
    "frontend",
    "ui",
    "microfrontends"
  ],
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-framework.git",
    "directory": "packages/framework/esm-framework"
  },
  "bugs": {
    "url": "https://github.com/amourgit/Frontend-esm-framework/issues"
  },
  "homepage": "https://github.com/amourgit/Frontend-esm-framework/tree/main/packages/framework/esm-framework#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@egen-civitas/esm-ai-framework": "^1.0.0",
    "@egen-civitas/esm-api": "^1.1.0",
    "@egen-civitas/esm-config": "^1.0.0",
    "@egen-civitas/esm-context": "^1.0.0",
    "@egen-civitas/esm-data-api": "^1.0.0",
    "@egen-civitas/esm-dynamic-loading": "^2.0.0",
    "@egen-civitas/esm-error-handling": "^1.0.0",
    "@egen-civitas/esm-expression-evaluator": "^1.0.0",
    "@egen-civitas/esm-extensions": "^1.0.0",
    "@egen-civitas/esm-feature-flags": "^1.0.0",
    "@egen-civitas/esm-globals": "^1.0.0",
    "@egen-civitas/esm-navigation": "^1.0.0",
    "@egen-civitas/esm-offline": "^1.0.0",
    "@egen-civitas/esm-react-utils": "^1.0.2",
    "@egen-civitas/esm-routes": "^1.0.2",
    "@egen-civitas/esm-state": "^1.0.0",
    "@egen-civitas/esm-styleguide": "^1.6.0",
    "@egen-civitas/esm-tenant": "^1.0.0",
    "@egen-civitas/esm-translations": "^1.0.0",
    "@egen-civitas/esm-utils": "^1.0.0"
  },
  "peerDependencies": {
    "dayjs": "1.x",
    "i18next": "25.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "rxjs": "7.x",
    "single-spa": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@egen-civitas/typedoc-plugin-file-categories": "^1.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "happy-dom": "^20.6.0",
    "i18next": "^25.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-is": "^17.0.2",
    "rimraf": "^6.1.3",
    "sass": "^1.98.0",
    "single-spa": "^6.0.3",
    "typedoc": "^0.28.5",
    "typedoc-plugin-markdown": "^4.6.3",
    "typedoc-plugin-no-inherit": "^1.6.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  }
}
