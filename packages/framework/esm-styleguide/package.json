{
  "name": "@egen-civitas/esm-styleguide",
  "version": "1.4.0",
  "license": "MPL-2.0",
  "description": "The styleguide for Egen SPA",
  "main": "dist/internal.js",
  "files": [
    "dist",
    "mock.tsx",
    "mock-jest.tsx",
    "src/_vars.scss"
  ],
  "module": "dist/internal.js",
  "types": "dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./src/internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./src/public": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    },
    "./src/index": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles": {
      "sass": "./dist/_all.scss",
      "default": "./dist/_all.scss"
    },
    "./src/vars": {
      "sass": "./src/_vars.scss"
    },
    "./mock": {
      "import": "./mock.tsx",
      "require": "./mock-jest.tsx"
    }
  },
  "source": true,
  "scripts": {
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths --copy-files src -d dist && svgo -rf dist --quiet\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths --copy-files src -d dist\" \"tsc --project tsconfig.build.json\"",
    "lint": "eslint src"
  },
  "keywords": [
    "egen",
    "microfrontends",
    "styleguide"
  ],
  "directories": {
    "lib": "dist",
    "src": "src"
  },
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-framework.git",
    "directory": "packages/framework/esm-styleguide"
  },
  "bugs": {
    "url": "https://github.com/amourgit/Frontend-esm-framework/issues"
  },
  "homepage": "https://github.com/amourgit/Frontend-esm-framework/tree/main/packages/framework/esm-styleguide#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@carbon/charts": "^1.27.0",
    "@carbon/react": "^1.92.1",
    "@internationalized/date": "^3.8.0",
    "@react-aria/utils": "^3.28.2",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^2.0.58",
    "d3": "^7.8.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "geopattern": "^1.2.3",
    "gsap": "^3.12.5",
    "lodash-es": "^4.17.21",
    "react-aria-components": "^1.7.1"
  },
  "peerDependencies": {
    "@egen-civitas/esm-api": "^1.1.1",
    "@egen-civitas/esm-config": "^1.0.0",
    "@egen-civitas/esm-data-api": "^1.0.2",
    "@egen-civitas/esm-error-handling": "^1.0.0",
    "@egen-civitas/esm-extensions": "^1.0.2",
    "@egen-civitas/esm-globals": "^1.0.0",
    "@egen-civitas/esm-navigation": "^1.0.2",
    "@egen-civitas/esm-react-utils": "^1.0.3",
    "@egen-civitas/esm-routes": "^1.0.0",
    "@egen-civitas/esm-state": "^1.0.0",
    "@egen-civitas/esm-translations": "^1.0.0",
    "@egen-civitas/esm-utils": "^1.0.0",
    "dayjs": "1.x",
    "i18next": "25.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "rxjs": "7.x",
    "single-spa": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@egen-civitas/esm-api": "^1.1.1",
    "@egen-civitas/esm-config": "^1.0.0",
    "@egen-civitas/esm-data-api": "^1.0.2",
    "@egen-civitas/esm-error-handling": "^1.0.0",
    "@egen-civitas/esm-expression-evaluator": "^1.0.0",
    "@egen-civitas/esm-extensions": "^1.0.2",
    "@egen-civitas/esm-globals": "^1.0.0",
    "@egen-civitas/esm-navigation": "^1.0.2",
    "@egen-civitas/esm-react-utils": "^1.0.3",
    "@egen-civitas/esm-routes": "^1.0.0",
    "@egen-civitas/esm-state": "^1.0.0",
    "@egen-civitas/esm-translations": "^1.0.0",
    "@egen-civitas/esm-utils": "^1.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@types/geopattern": "^1.2.9",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.6.0",
    "i18next": "^25.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^17.0.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.0",
    "sass": "^1.98.0",
    "single-spa": "^6.0.3",
    "svgo": "^3.3.2",
    "swr": "2.2.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  }
}
