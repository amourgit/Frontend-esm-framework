{
  "name": "@egen-civitas/esm-ai-tools",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "Registry de tools IA EGEN — tools natifs, pipeline de validation, vérification des permissions, exécution contrôlée.",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "typescript": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext ts,tsx",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests"
  },
  "keywords": [
    "egen",
    "microfrontends",
    "ai",
    "tools"
  ],
  "browserslist": [
    "extends browserslist-config-egen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amourgit/Frontend-esm-core.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@egen-civitas/esm-ai-config": "^1.0.0",
    "@egen-civitas/esm-ai-context": "^1.0.0",
    "@egen-civitas/esm-ai-events": "^1.0.0",
    "@egen-civitas/esm-api": "^1.0.0",
    "@egen-civitas/esm-navigation": "^1.0.0",
    "@egen-civitas/esm-state": "^1.0.0",
    "@egen-civitas/esm-styleguide": "^1.0.0",
    "@egen-civitas/esm-tenant": "^1.0.0"
  },
  "peerDependencies": {
    "@egen-civitas/esm-api": "^1.0.0",
    "@egen-civitas/esm-state": "^1.0.0",
    "rxjs": "^6.5.3"
  },
  "devDependencies": {
    "@egen-civitas/esm-ai-config": "^1.0.0",
    "@egen-civitas/esm-ai-context": "^1.0.0",
    "@egen-civitas/esm-ai-events": "^1.0.0",
    "@egen-civitas/esm-api": "^1.0.0",
    "@egen-civitas/esm-state": "^1.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.21",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "rxjs": "^6.5.3",
    "vitest": "^4.1.2"
  }
}
